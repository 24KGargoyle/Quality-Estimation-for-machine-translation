# Copy to .env and fill in. Never commit the real .env file.

APP_ENV=local
DATABASE_URL=postgresql+asyncpg://meeting_intel:meeting_intel@localhost:5432/meeting_intel
SECRET_KEY=change-me-to-a-random-secret

# "dev" for local development without a live Microsoft Entra ID tenant.
# "entra" for production — requires the MS_* settings below.
AUTH_PROVIDER=dev

# --- Microsoft Entra ID / Graph (required when AUTH_PROVIDER=entra) ---
# See docs/MICROSOFT_GRAPH_PERMISSIONS.md for the app registration + permissions needed.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8000/api/auth/entra/callback

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
