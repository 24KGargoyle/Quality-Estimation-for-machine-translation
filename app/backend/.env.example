# Copy to .env and fill in. Never commit the real .env file.

APP_ENV=local

# --- Database ---
# Real, working default: SQLite via the async aiosqlite driver — no external
# database server required for local development or tests.
DATABASE_URL=sqlite+aiosqlite:///./data/meeting_intel.db
# Production target. When set, takes precedence over DATABASE_URL. Must use
# an async-capable SQLAlchemy driver — see docs/AZURE_SETUP.md.
AZURE_SQL_CONNECTION_STRING=

SECRET_KEY=change-me-to-a-random-secret

# "dev" for local development without a live Microsoft Entra ID tenant.
# "entra" for production — requires the MS_* settings below.
AUTH_PROVIDER=dev

# --- Microsoft Entra ID / Graph (required when AUTH_PROVIDER=entra) ---
# See docs/MICROSOFT_GRAPH_PERMISSIONS.md for the app registration + permissions needed.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8000/api/auth/entra/callback

# --- LLM ---
# "anthropic" (default, working today) or "azure_openai" (real, inert
# without the AZURE_OPENAI_* settings below).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Embeddings ---
# "local" (default, working today — sentence-transformers, no API key) or
# "azure_openai" (real, inert without the AZURE_OPENAI_* settings below).
EMBEDDING_PROVIDER=local

# --- Azure OpenAI (required only when LLM_PROVIDER or EMBEDDING_PROVIDER=azure_openai) ---
# See docs/AZURE_SETUP.md. Never inferred/hard-coded — must match your actual
# deployed model and its real embedding output size.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DIMENSIONS=

# --- Search (RAG) ---
# "memory" (default): a real, working, in-process hybrid search
#   implementation for local development and tests — NOT Azure AI Search.
# "azure_search": real Azure AI Search (see docs/AZURE_SETUP.md and docs/RAG.md).
SEARCH_PROVIDER=memory
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=transcript-chunks
AZURE_SEARCH_SEMANTIC_CONFIG=default

# --- Historical Meeting Data Import (see docs/HISTORICAL_IMPORT.md) ---
# "local" (default): a real, working on-disk store for dev/tests — NOT Azure
#   Blob Storage. "azure_blob": a real Azure Blob Storage REST client, inert
#   without AZURE_STORAGE_CONTAINER_SAS_URL.
FILE_STORAGE=local
LOCAL_BLOB_STORAGE_DIR=./data/historical_blobs
AZURE_STORAGE_CONTAINER_SAS_URL=
IMPORT_MAX_CONCURRENCY=4

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
